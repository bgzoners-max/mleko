# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure SQL migrations are always LF
*.sql text eol=lf

# Dart, TypeScript, JavaScript, JSON, YAML, Markdown
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Shell & script files
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary

# Supabase konfiguracija za Naše Selo
# 
# 1. Idi na https://supabase.com/dashboard → tvoj projekat → Settings → API
# 2. Kopiraj URL i anon/public key
# 3. Kreiraj .env fajl iz ovog .env.example i popuni
# 4. Gitignore .env (dodaj u .gitignore ako nema)
# 5. flutter run

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcionalno: Share base URL za web/deep links
SHARE_BASE_URL=https://mleko.app

